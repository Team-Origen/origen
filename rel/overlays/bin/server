#!/bin/sh
set -eu

# Runs pending migrations, then starts the web server. If a migration fails,
# the script exits before the server starts, so the new version never
# answers the health check and Render does not switch traffic to it.
RELEASE_ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
"$RELEASE_ROOT/migrate"
PHX_SERVER=true exec "$RELEASE_ROOT/origen" start
