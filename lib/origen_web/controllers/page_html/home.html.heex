<main class="min-h-screen bg-[#F6F6F4] flex items-center justify-center p-8 font-inter">
  <div class="max-w-md w-full bg-white border border-[#AFBAB4]/40 rounded-xl shadow-[0px_4px_20px_rgba(10,56,71,0.06)] p-8 text-center">
    <div :if={@current_patient}>
      <div class="mx-auto flex items-center justify-center h-14 w-14 rounded-full bg-[#DDE6DB] mb-4">
        <.icon name="hero-check-circle" class="h-8 w-8 text-[#0A3847]" />
      </div>
      <h1 class="text-2xl font-semibold text-[#0A3847] mb-2 font-inter">¡Acceso Verificado!</h1>
      <p class="text-sm text-[#35545A] mb-4 font-inter">
        Sesión iniciada como: <span class="font-semibold text-[#0A3847]">{@current_patient}</span>
      </p>
      <p class="text-xs text-gray-500 mb-6 font-inter">
        Tu identidad ha sido autenticada exitosamente mediante Magic Link.
      </p>
      <a
        href={~p"/access"}
        class="inline-block text-sm text-[#0A3847] font-semibold hover:underline"
      >
        Solicitar otro enlace o cambiar de cuenta
      </a>
    </div>

    <div :if={is_nil(@current_patient)}>
      <h1 class="text-2xl font-semibold text-[#0A3847] mb-4 font-inter">
        Portal de Pacientes Origen
      </h1>
      <p class="text-sm text-[#35545A] mb-6 font-inter">
        Accedé a tus turnos y gestiones médicas de manera segura y sin contraseña.
      </p>
      <.link
        navigate={~p"/access"}
        class="inline-block bg-[#0A3847] text-white px-6 py-2.5 rounded-md font-semibold hover:bg-[#072732] transition-colors"
      >
        Ingresar con mi correo
      </.link>
    </div>
  </div>
</main>
